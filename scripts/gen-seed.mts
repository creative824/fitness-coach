// Generates supabase/seed/content.sql from src/content/*.ts.
// Run: npm run seed:gen   (then paste the SQL into Supabase SQL Editor)
// Upserts by slug. Re-running never overwrites review_status, so approvals made in the admin survive.
import { writeFileSync } from "node:fs";
import { EXERCISES } from "../src/content/exercises.ts";
import { MUSCLES } from "../src/content/muscles.ts";
import { MEAL_IDEAS } from "../src/content/meal-ideas.ts";

const q = (s: string | null | undefined) => (s === null || s === undefined ? "null" : `'${s.replaceAll("'", "''")}'`);
const arr = (xs: readonly (string | number)[]) =>
  xs.length ? `array[${xs.map((x) => (typeof x === "number" ? x : q(x))).join(",")}]` : "'{}'";

const out: string[] = [
  "-- Generated by scripts/gen-seed.mts. Do not edit by hand.",
  "begin;",
  "",
  "-- Muscles",
  ...MUSCLES.map(
    (m) =>
      `insert into public.muscles (id, name_he, view, description_he) values (${q(m.id)}, ${q(m.name_he)}, ${q(m.view)}, ${q(m.description_he)})\n` +
      `  on conflict (id) do update set name_he = excluded.name_he, view = excluded.view, description_he = excluded.description_he;`,
  ),
  "",
  "-- Exercises (inserted as drafts; approval happens in the admin screen)",
  ...EXERCISES.map(
    (e) =>
      `insert into public.exercises (slug, name_he, instructions_he, cautions_he, equipment, difficulty, primary_muscles, secondary_muscles, contraindications, category, mode, easier_slug)\n` +
      `  values (${q(e.slug)}, ${q(e.name_he)}, ${q(e.steps.join("\n"))}, ${q(e.cautions)}, ${arr(e.equipment)}::text[], ${q(e.difficulty)}, ${arr(e.primary)}::text[], ${arr(e.secondary)}::text[], ${arr(e.contraindications)}::text[], ${q(e.category)}, ${q(e.mode)}, ${q(e.easier ?? null)})\n` +
      `  on conflict (slug) do update set name_he = excluded.name_he, instructions_he = excluded.instructions_he, cautions_he = excluded.cautions_he, equipment = excluded.equipment, difficulty = excluded.difficulty, primary_muscles = excluded.primary_muscles, secondary_muscles = excluded.secondary_muscles, contraindications = excluded.contraindications, category = excluded.category, mode = excluded.mode, easier_slug = excluded.easier_slug;`,
  ),
  "",
  "-- Meal ideas (inserted as drafts; no amounts, no steps, no calorie numbers)",
  ...MEAL_IDEAS.map(
    (m) =>
      `insert into public.meal_ideas (slug, title_he, hint_he, meal_type, portion, components, dietary_tags, allergens)\n` +
      `  values (${q(m.slug)}, ${q(m.title_he)}, ${q(m.hint_he ?? null)}, ${arr(m.meal_type)}::text[], ${q(m.portion)}, ${arr(m.components)}::text[], ${arr(m.diet)}::text[], ${arr(m.allergens)}::text[])\n` +
      `  on conflict (slug) do update set title_he = excluded.title_he, hint_he = excluded.hint_he, meal_type = excluded.meal_type, portion = excluded.portion, components = excluded.components, dietary_tags = excluded.dietary_tags, allergens = excluded.allergens;`,
  ),
  "",
  "commit;",
  "",
];

writeFileSync(new URL("../supabase/seed/content.sql", import.meta.url), out.join("\n"));
console.log(`content.sql: ${MUSCLES.length} muscles, ${EXERCISES.length} exercises, ${MEAL_IDEAS.length} meal ideas`);
