# Copy to .env.local for development. Never commit real values.

# Supabase (phase 1). The anon key is public by design; the service role key is SERVER ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (phase 3+). Server only.
OPENAI_API_KEY=

# Billing is prepared but OFF (spec §19). Do not change during beta.
BILLING_ENABLED=false
PREMIUM_GATING_ENABLED=false
